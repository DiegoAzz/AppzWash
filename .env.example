# APPZ WASH Environment Variables

# Node Environment
NODE_ENV=development
PORT=3000

# Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/appzwash_dev?schema=public"

# Multi-tenant Default / Demo Tenant for Local Testing
NEXT_PUBLIC_DEFAULT_TENANT_SLUG="autolavado-el-parche"

# JWT Secret for Session & Tokens
JWT_SECRET="super-secret-jwt-key-change-in-production-appzwash-2026"
